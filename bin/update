#!/bin/sh
# BariSign - update in place. Uses git when this is a git checkout, otherwise
# re-runs the installer (which needs only curl).
cd "$(dirname "$0")/.." || exit 1
if [ -d .git ] && command -v git >/dev/null 2>&1; then
    echo "Updating with git in $(pwd)"
    git pull --ff-only || { echo "git pull failed - fix that first"; exit 1; }
else
    echo "Updating by re-running the installer in $(pwd)"
    if [ -f install.sh ]; then
        sh install.sh || exit 1
    else
        curl -sSL "https://github.com/barismd/barisign/blob/main/install.sh?raw=true" -o install.sh || exit 1
        sh install.sh || exit 1
    fi
fi
echo
echo "Ready."
