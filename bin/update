#!/bin/sh
# BariSign - update in place, quietly.
cd "$(dirname "$0")/.." || exit 1
if [ -d .git ] && command -v git >/dev/null 2>&1; then
    before=$(git rev-parse --short HEAD)
    git pull --ff-only -q || { echo "! update failed"; exit 1; }
    after=$(git rev-parse --short HEAD)
    [ "$before" = "$after" ] && echo "already up to date ($after)" || echo "updated $before -> $after"
    exit 0
fi
tmp=install.sh.new
rm -f "$tmp"
curl -sSL -H 'Cache-Control: no-cache' \
     "https://raw.githubusercontent.com/barismd/barisign/main/install.sh" -o "$tmp" || {
    echo "! no network"; exit 1; }
if BARISIGN_DIR="$PWD" sh "$tmp" >/dev/null 2>&1; then
    mv "$tmp" install.sh
    ver=$(python3 -c "import re;print(re.search(r'VERSION = \"([^\"]+)\"', open('poc/barisign.py').read()).group(1))")
    echo "BariSign $ver  installed"
else
    rm -f "$tmp"
    echo "! update failed; run 'sh install.sh' to see why"
    exit 1
fi
